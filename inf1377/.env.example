# Copie este arquivo para .env (na mesma pasta do manage.py) e ajuste os valores.

# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave

# True em desenvolvimento, False em produção
DJANGO_DEBUG=True

# Hosts permitidos, separados por vírgula
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
